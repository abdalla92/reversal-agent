# Atlas sandbox cluster: Cluster0 (mongodb+srv://cluster0.rbx58q.mongodb.net)
# Include the database user's credentials. Do not commit this file.
# If the password contains @ # / or :, leave it raw. The app encodes it before connecting.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.rbx58q.mongodb.net/?retryWrites=true&w=majority"

# Optional. Without these, the agent uses a local embedder and a deterministic ReAct planner.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-large
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Set to "llm" to let the model choose tools. Policy still blocks every money movement.
PLANNER=playbook
